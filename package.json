{
  "name": "@useorgx/orgx-opencode-plugin",
  "version": "0.1.0-alpha.6",
  "publishConfig": {
    "access": "public"
  },
  "description": "OrgX plugin peer for OpenCode with task dispatch, execution receipts, deviations, and passive Work Graph reconciliation events.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "orgx-opencode-plugin": "dist/cli.js",
    "orgx-opencode-reconcile-hooks": "scripts/orgx-work-graph-reconcile.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE",
    "plugin.manifest.json"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.node-test.mjs",
    "prepublishOnly": "npm run type-check && npm test && npm run build",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@sentry/node": "10.65.0",
    "@useorgx/orgx-gateway-sdk": "github:useorgx/orgx-gateway-sdk#40871edeb9b92eaf4403c0ba7270a74204ba425f"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.7",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "orgx",
    "opencode",
    "opencode-plugin",
    "plugin-peer",
    "byok"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useorgx/orgx-opencode-plugin.git"
  },
  "license": "MIT"
}
